# Variáveis de ambiente usadas em produção (configure no painel da hospedagem).
# Na máquina de vocês nada disso é necessário: o projeto usa valores de desenvolvimento.

# 0 = produção (desliga páginas de erro detalhadas). Padrão: 1
DJANGO_DEBUG=0

# Gere uma chave nova com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=troque-por-uma-chave-gerada

# Domínios do site, separados por vírgula
DJANGO_ALLOWED_HOSTS=meusite.onrender.com

# (Opcional, etapa de IA)
# ANTHROPIC_API_KEY=
